{
  "name": "@jarvis/local-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JARVIS local agent — loopback-only bridge to this computer (allowlisted operations only).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node ../../scripts/build-node.mjs src/index.ts dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jarvis/schemas": "workspace:*",
    "@jarvis/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
