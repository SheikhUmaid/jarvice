# ──────────────────────────────────────────────────────────────────────────────
# JARVIS environment. Copy to `.env` (git-ignored) and adjust.
# Every app reads this single file from the repository root.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend (apps/backend) ────────────────────────────────────────────────────
# Loopback only. A non-loopback host is refused unless JARVIS_BACKEND_ALLOW_LAN=true
# (not recommended: it exposes JARVIS to your network).
JARVIS_BACKEND_HOST=127.0.0.1
JARVIS_BACKEND_PORT=8787
JARVIS_BACKEND_ALLOW_LAN=false
# Comma-separated browser origins allowed to open the WebSocket / call the API
# (dev server and `vite preview`). localhost ⇄ 127.0.0.1 are treated as equivalent.
JARVIS_WEB_ORIGIN=http://localhost:5173,http://localhost:4173
# debug | info | warn | error
JARVIS_LOG_LEVEL=info

# ── Claude (used from Milestone 4; server-side only) ─────────────────────────
# NEVER prefix with VITE_ — VITE_* variables are bundled into the browser.
# If unset, the Anthropic SDK can also use a profile from `ant auth login`.
ANTHROPIC_API_KEY=
JARVIS_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (Opus 5.5 defaults to medium; set it explicitly)
JARVIS_CLAUDE_EFFORT=medium

# ── Local agent (apps/local-agent) ────────────────────────────────────────────
# Must be a loopback address; anything else is refused at startup.
JARVIS_AGENT_HOST=127.0.0.1
JARVIS_AGENT_PORT=8788
# Comma-separated browser origins allowed to call the agent.
JARVIS_AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Web (apps/web) — VITE_* values are PUBLIC: never put secrets here ────────
VITE_JARVIS_AGENT_URL=http://127.0.0.1:8788
